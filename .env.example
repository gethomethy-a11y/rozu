# Copy to .env.local for local development. .env.local is gitignored and must
# stay that way — the real values live only in Vercel's Environment Variables.
#
# NEVER prefix any of these with NEXT_PUBLIC_. That prefix inlines the value
# into the JavaScript that ships to the browser.

# ── Anthropic ────────────────────────────────────────────────────────────────
# Used only by /api/generate, and only after a payment has been verified.
# If unset, a paid customer still gets the deterministic fallback routine
# rather than an error.
ANTHROPIC_API_KEY=

# ── Lemon Squeezy ────────────────────────────────────────────────────────────
# SECRET. Settings -> API -> create a key.
LEMONSQUEEZY_API_KEY=
# SECRET. The signing secret you invented when creating the webhook. Must be
# byte-identical to the one in the Lemon Squeezy webhook settings.
LEMONSQUEEZY_WEBHOOK_SECRET=
# Not secret. Settings -> Stores.
LEMONSQUEEZY_STORE_ID=
# Not secret. The single default variant of each product — the number at the end
# of the URL when you open that variant.
LEMONSQUEEZY_VARIANT_SOLO=
LEMONSQUEEZY_VARIANT_COUPLE=

# ── Proof-of-payment token ───────────────────────────────────────────────────
# SECRET. Any random string, 32+ characters. Signs the token that /api/generate
# accepts as proof an order was paid for. Rotating it invalidates every token
# already issued, so a customer mid-purchase would lose access.
# Generate one with:  openssl rand -hex 32
ROZU_TOKEN_SECRET=

# ── Storage ──────────────────────────────────────────────────────────────────
# Pick ONE. Supabase wins if both are set.
#
# Supabase. SUPABASE_SERVICE_ROLE_KEY is SECRET — it bypasses row level
# security. Never the anon key, and never NEXT_PUBLIC_. Needs the rozu_kv table;
# /api/setup prints the SQL.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
#
# Or Upstash Redis, set automatically by Vercel -> Storage. Do not type these by
# hand in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# With neither, the app falls back to an in-process map so `next dev` works
# without a database. That fallback refuses to serve checkout in production,
# because an order it forgets is an order that was paid for and never
# delivered.

# ── Preview mode (temporary, for reviewing the finished result) ──────────────
# SECRET, 16+ characters. While set, visiting /?preview=<value> makes the
# Unlock button skip Lemon Squeezy: the order is written already marked paid and
# everything after that — token, AI call, caching — runs exactly as it does for
# a real customer. Anyone who knows the value gets free routines, so DELETE THIS
# BEFORE LAUNCH. /api/setup shouts about it while it is set.
# ROZU_PREVIEW_KEY=

# ── Payment mode ─────────────────────────────────────────────────────────────
# Checkouts run in TEST MODE unless this is explicitly 0/false/no/off. Test mode
# takes test cards only and never charges a real one. Set to 0 to go live.
# LEMONSQUEEZY_TEST_MODE=0

# ── Attribution (public by design) ───────────────────────────────────────────
# Pixel IDs appear in the page source of every site that uses them, so
# NEXT_PUBLIC_ is correct here — and only here. Nothing loads until the visitor
# accepts the consent banner. Leave unset and no pixel exists at all.
# NEXT_PUBLIC_TIKTOK_PIXEL_ID=
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# ── Site ─────────────────────────────────────────────────────────────────────
# Optional. The canonical origin used to build the post-payment return URL.
# Derived from the request when unset, which is correct on Vercel. Set it once
# there is a custom domain.
# ROZU_SITE_URL=https://rozu.example
